# =============================================================================
# AlToque AI -- Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Do not commit .env to version control.
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://altoque:altoque_dev@localhost:5432/altoque_db
DATABASE_URL_SYNC=postgresql://altoque:altoque_dev@localhost:5432/altoque_db
POSTGRES_USER=altoque
POSTGRES_PASSWORD=altoque_dev
POSTGRES_DB=altoque_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication ---
SECRET_KEY=change-this-to-a-secure-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- LLM Provider ---
# Supported: openai, gemini, anthropic
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_EXTRACTION_MODEL=gpt-4o

# --- WhatsApp Business API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- File Storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- Application ---
APP_NAME=AlToque AI
APP_VERSION=0.1.0
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
