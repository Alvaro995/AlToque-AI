
# --- Base de Datos ---
DATABASE_URL=postgresql+asyncpg://altoque:altoque_dev@localhost:5432/altoque_db
DATABASE_URL_SYNC=postgresql://altoque:altoque_dev@localhost:5432/altoque_db
POSTGRES_USER=altoque
POSTGRES_PASSWORD=altoque_dev
POSTGRES_DB=altoque_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Autenticación ---
SECRET_KEY=change-this-to-a-secure-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- Proveedor LLM ---
# Soportados: openai, gemini, anthropic
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_EXTRACTION_MODEL=gpt-4o

# --- API de WhatsApp Business ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- Almacenamiento de Archivos ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- Aplicación ---
APP_NAME=AlToque AI
APP_VERSION=0.1.0
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# --- Railway (Backend PaaS) ---
# Railway inyecta PORT automáticamente. No es necesario definirlo manualmente.
PORT=8000

# --- Vercel (Frontend) ---
# URL pública del backend desplegado en Railway (sin barra final)
PUBLIC_API_URL=https://su-backend.up.railway.app
# URL del frontend en Vercel (para configurar CORS)
FRONTEND_URL=https://su-app.vercel.app
